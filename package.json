{
  "name": "weather",
  "displayName": "Weather",
  "description": "%extension.description%",
  "version": "0.0.1",
  "license": "MIT",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "weather.refresh",
        "title": "%command.refresh%"
      },
      {
        "command": "weather.openSettings",
        "title": "%command.openSettings%"
      },
      {
        "command": "weather.chooseLocation",
        "title": "%command.chooseLocation%"
      }
    ],
    "configuration": {
      "title": "Weather",
      "properties": {
        "weather.location": {
          "type": "string",
          "default": "",
          "scope": "window",
          "markdownDescription": "%configuration.location%"
        },
        "weather.refreshInterval": {
          "type": "number",
          "default": 15,
          "minimum": 5,
          "maximum": 120,
          "scope": "window",
          "description": "%configuration.refreshInterval%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "pretest:languages": "npm run compile && npm run lint",
    "test:languages": "vscode-test --config .vscode-test.languages.mjs"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.140.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "ky": "^2.2.0",
    "zod": "^4.6.7"
  },
  "l10n": "./l10n"
}
